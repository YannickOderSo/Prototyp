# Vorlage für die Produktion (docker-compose.prod.yml). Auf dem Server als .env ablegen, Rechte 0600.
# Echte Werte nie committen. Herkunft jedes Werts: vault/03-Umsetzung/Betriebshandbuch.md, „Benötigte Zugänge“.

# Image aus der CI (per Git-Tag gebaut), z. B. ghcr.io/yannickoderso/prototyp:v1.0.0
COCKPIT_IMAGE=
COCKPIT_DOMAIN=cockpit.example.de
COCKPIT_ACME_EMAIL=
COCKPIT_BASIS_URL=https://cockpit.example.de
DJANGO_ALLOWED_HOSTS=cockpit.example.de
DJANGO_SECRET_KEY=
# Mehrere Schlüssel kommagetrennt, neuester zuerst (Rotation: Betriebshandbuch)
COCKPIT_FERNET_KEYS=

# Datenbank: Eigentümer (nur Migrationen) und App-Rolle (Web und Worker)
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=
POSTGRES_DB=cockpit
COCKPIT_DB_APP_ROLLE=cockpit_app
COCKPIT_DB_APP_PASSWORT=

# Mailversand der Plattform (EU-Anbieter mit AVV)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
ZUSTELLUNG_WEBHOOK_TOKEN=

# Belegpostfach (IMAP)
BELEGPOSTFACH_ADRESSE=
BELEGPOSTFACH_IMAP_HOST=
BELEGPOSTFACH_IMAP_BENUTZER=
BELEGPOSTFACH_IMAP_PASSWORT=
BELEGPOSTFACH_AUTHSERV_ID=

# KI: nur EU-Endpunkte
MISTRAL_API_KEY=
BEDROCK_REGION=eu-central-1
BEDROCK_MODELL=eu.anthropic.claude-sonnet-5-5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fehlererfassung: GlitchTip selbst gehostet oder Sentry mit EU-Datenhaltung (*.de.sentry.io)
SENTRY_DSN=
SENTRY_UMGEBUNG=produktion

# Sicherung (restic auf Hetzner Storage Box, SSH-Port 23 in geheim/ssh/config)
RESTIC_REPOSITORY=sftp:storagebox:/cockpit
BACKUP_PING_URL=
