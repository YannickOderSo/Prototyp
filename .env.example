# Beispielbelegung für die lokale Entwicklung. Kopieren nach .env und anpassen.
# Echte Schlüssel nie committen.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=bitte-ersetzen-lokal
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://cockpit:cockpit@localhost:5432/cockpit
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COCKPIT_FERNET_KEYS=bitte-erzeugen
COCKPIT_BASIS_URL=http://localhost:8000
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=cockpit@localhost
COCKPIT_HINTER_PROXY=false
ZUSTELLUNG_WEBHOOK_TOKEN=
BELEGPOSTFACH_ADRESSE=
BELEGPOSTFACH_IMAP_HOST=
BELEGPOSTFACH_IMAP_BENUTZER=
BELEGPOSTFACH_IMAP_PASSWORT=
BELEGPOSTFACH_AUTHSERV_ID=
MISTRAL_API_KEY=
BEDROCK_REGION=eu-central-1
BEDROCK_MODELL=eu.anthropic.claude-sonnet-5-5
# KI-Telefonassistent (ADR-010)
TELEFON_MODELL=eu.anthropic.claude-haiku-5-5
TELEFON_SPRACHAUSGABE=voxtral
MISTRAL_TTS_MODELL=voxtral-mini-tts-3-0
MISTRAL_TTS_STIMME=voice_481
TELEFON_ASTERISK_TOKEN=
