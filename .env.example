# Beispielbelegung für die lokale Entwicklung. Kopieren nach .env und anpassen.
# Echte Schlüssel nie committen.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=bitte-ersetzen-lokal
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://cockpit:cockpit@localhost:5432/cockpit
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COCKPIT_FERNET_KEYS=bitte-erzeugen
COCKPIT_BASIS_URL=http://localhost:8000
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=cockpit@localhost
COCKPIT_HINTER_PROXY=false
ZUSTELLUNG_WEBHOOK_TOKEN=
